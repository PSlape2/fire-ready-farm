# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API key — https://home.openweathermap.org/api_keys (free tier)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ngrok authtoken — https://dashboard.ngrok.com/get-started/your-authtoken
# NOT stored here — set via CLI: ngrok config add-authtoken <your_token>

# No key needed: Open-Meteo (frontend weather) and HuggingFace ONNX (local image analysis) are fully free
